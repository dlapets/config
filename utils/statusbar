get_battery() {
    local DEV="/sys/class/power_supply/BAT0/uevent"
    local PERCENT=$(cat $DEV | grep "_CAPACITY=" | sed 's/.*=//')
    local STATUS=$(cat $DEV | grep "_STATUS=" | sed 's/.*=//')

    # "🔋";
    # "🪫"
    # "⚡"
    # "🔌";
    local ICON="🔋";
    case "$STATUS" in
        "Not charging")
            local ICON="🔌";
            ;;

        "Charging")
            local ICON="⚡"
            ;;

        "Discharging")
            if (( PERCENT < 20 )); then
                local ICON="🪫";

            else
                local ICON="🔋";
            fi
            ;;
    esac

    echo "$ICON $PERCENT%";
}

get_thermals() {
    local DEV="/sys/class/thermal/thermal_zone0/temp"
    local TEMP=$( cat $DEV );
    local TEMP=$(( $TEMP / 1000 ));
    printf "🌡️ ${TEMP}°C"
}

while true; do
    CLOCK=$(get_clock);
    BAT="$(get_battery)";
    THERMALS="$(get_thermals)";
    echo "$THERMALS    $BAT    $CLOCK"
    sleep 0.01;
done
