#!/bin/bash


get_clock() {
    local REAL_TIME="$( date +'%Y-%m-%d %H:%M:%S' )";

    # For icon, get time in 15 minutes to that e.g. 11:20 shows up with the
    # minute hand pointing down.
    local ICON_TIME="$( date -d '+15 minutes' '+%I%M' | sed -e 's/^0//' )";
    local ICON="???"
    if   (( ICON_TIME >= 1230 )); then local ICON="🕧";
    elif (( ICON_TIME >= 1200 )); then local ICON="🕛";
    elif (( ICON_TIME >= 1130 )); then local ICON="🕦";
    elif (( ICON_TIME >= 1100 )); then local ICON="🕚";
    elif (( ICON_TIME >= 1030 )); then local ICON="🕥";
    elif (( ICON_TIME >= 1000 )); then local ICON="🕙";
    elif (( ICON_TIME >= 930  )); then local ICON="🕤";
    elif (( ICON_TIME >= 900  )); then local ICON="🕘";
    elif (( ICON_TIME >= 830  )); then local ICON="🕣";
    elif (( ICON_TIME >= 800  )); then local ICON="🕗";
    elif (( ICON_TIME >= 730  )); then local ICON="🕢";
    elif (( ICON_TIME >= 700  )); then local ICON="🕖";
    elif (( ICON_TIME >= 630  )); then local ICON="🕡";
    elif (( ICON_TIME >= 600  )); then local ICON="🕕";
    elif (( ICON_TIME >= 530  )); then local ICON="🕠";
    elif (( ICON_TIME >= 500  )); then local ICON="🕔";
    elif (( ICON_TIME >= 430  )); then local ICON="🕟";
    elif (( ICON_TIME >= 400  )); then local ICON="🕓";
    elif (( ICON_TIME >= 330  )); then local ICON="🕞";
    elif (( ICON_TIME >= 300  )); then local ICON="🕒";
    elif (( ICON_TIME >= 230  )); then local ICON="🕝";
    elif (( ICON_TIME >= 200  )); then local ICON="🕑";
    elif (( ICON_TIME >= 130  )); then local ICON="🕜";
    elif (( ICON_TIME >= 100  )); then local ICON="🕐";
    fi

    echo "$ICON $REAL_TIME";
}


